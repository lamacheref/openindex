# Dockerfile pour le service API FastAPI
FROM python:3.11-slim

ARG OPENINDEX_APP_VERSION=0.6.0
ARG OPENINDEX_BUILD_COMMIT=dev
ARG OPENINDEX_BUILD_DATE=20260408_120000

# Métadonnées
LABEL maintainer="OpenIndex Team"
LABEL description="OpenIndex FastAPI Service"
LABEL version="${OPENINDEX_APP_VERSION}"
LABEL org.opencontainers.image.version="${OPENINDEX_APP_VERSION}"
LABEL org.opencontainers.image.revision="${OPENINDEX_BUILD_COMMIT}"
LABEL org.opencontainers.image.created="${OPENINDEX_BUILD_DATE}"

# Configuration
WORKDIR /app

# Installation des dépendances système
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Installation des dépendances Python
COPY requirements/dev.txt ./requirements/dev.txt
RUN pip install --no-cache-dir -r requirements/dev.txt

# Copier les sources de l'API
COPY VERSION ./VERSION
COPY backend/src/ ./backend/src/
COPY config/ ./config/
COPY database/ ./database/

# Créer les répertoires nécessaires
RUN mkdir -p logs data

# Variables d'environnement
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV FASTAPI_HOST=0.0.0.0
ENV FASTAPI_PORT=8000
ENV OPENINDEX_APP_VERSION=${OPENINDEX_APP_VERSION}
ENV OPENINDEX_BUILD_COMMIT=${OPENINDEX_BUILD_COMMIT}
ENV OPENINDEX_BUILD_DATE=${OPENINDEX_BUILD_DATE}

# Health check pour l'API
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Point d'entrée
ENTRYPOINT ["uvicorn", "backend.src.api.main:app"]
CMD ["--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
