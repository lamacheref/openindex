#!/usr/bin/env bash
set -euo pipefail

LOCK="/tmp/git-readme-update.lock"

[ -f "$LOCK" ] && exit 0
trap 'rm -f "$LOCK"' EXIT
touch "$LOCK"

cd "$(git rev-parse --show-toplevel)"

[ "$(git rev-parse --abbrev-ref HEAD)" != "main" ] && exit 0

bash scripts/update_readme_history.sh

if ! git diff --quiet README.md 2>/dev/null || ! git diff --cached --quiet README.md 2>/dev/null; then
  git add README.md
  git commit --amend --no-edit
fi
