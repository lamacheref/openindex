# Dockerfile pour le service Frontend VanillaJS
FROM node:22-alpine AS frontend-builder

ARG OPENINDEX_APP_VERSION=0.4.12

WORKDIR /build

COPY VERSION ./
COPY package.json ./
COPY tailwind.config.js ./
RUN npm install

COPY frontend/ ./frontend/
RUN mkdir -p frontend/assets/fontawesome/css \
    && npm run build:frontend \
    && cp node_modules/alpinejs/dist/cdn.min.js frontend/assets/alpine.min.js \
    && cp node_modules/@fortawesome/fontawesome-free/css/all.min.css frontend/assets/fontawesome/css/all.min.css \
    && cp -R node_modules/@fortawesome/fontawesome-free/webfonts frontend/assets/fontawesome/

FROM nginx:alpine

ARG OPENINDEX_APP_VERSION=0.4.12
ARG OPENINDEX_BUILD_COMMIT=dev
ARG OPENINDEX_BUILD_DATE=20260401_173742

# Métadonnées
LABEL maintainer="OpenIndex Team"
LABEL description="OpenIndex Frontend Service"
LABEL version="${OPENINDEX_APP_VERSION}"
LABEL org.opencontainers.image.version="${OPENINDEX_APP_VERSION}"
LABEL org.opencontainers.image.revision="${OPENINDEX_BUILD_COMMIT}"
LABEL org.opencontainers.image.created="${OPENINDEX_BUILD_DATE}"

# Installation des utilitaires
RUN apk add --no-cache \
    curl \
    && rm -rf /var/cache/apk/*

# Copier les sources du frontend
COPY --from=frontend-builder /build/frontend/ /usr/share/nginx/html/

# Configuration Nginx optimisée
COPY nginx/nginx.conf /etc/nginx/nginx.conf

# Créer les répertoires nécessaires
RUN mkdir -p /var/cache/nginx /var/log/nginx

# Variables d'environnement
ENV NGINX_HOST=0.0.0.0
ENV NGINX_PORT=3000
ENV OPENINDEX_APP_VERSION=${OPENINDEX_APP_VERSION}
ENV OPENINDEX_BUILD_COMMIT=${OPENINDEX_BUILD_COMMIT}
ENV OPENINDEX_BUILD_DATE=${OPENINDEX_BUILD_DATE}

# Health check pour le frontend
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:3000/health || exit 1

# Exposer le port
EXPOSE 3000

# Point d'entrée
CMD ["nginx", "-g", "daemon off;"]
