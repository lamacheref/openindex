# Dockerfile pour le service Crawler Python
FROM python:3.11-slim

ARG OPENINDEX_APP_VERSION=0.3.0
ARG OPENINDEX_BUILD_COMMIT=dev
ARG OPENINDEX_BUILD_DATE=unknown

# Métadonnées
LABEL maintainer="OpenIndex Team"
LABEL description="OpenIndex Crawler Service"
LABEL version="${OPENINDEX_APP_VERSION}"
LABEL org.opencontainers.image.version="${OPENINDEX_APP_VERSION}"
LABEL org.opencontainers.image.revision="${OPENINDEX_BUILD_COMMIT}"
LABEL org.opencontainers.image.created="${OPENINDEX_BUILD_DATE}"

# Configuration
WORKDIR /app

# Installation des dépendances système
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Installation des dépendances Python
COPY Archives/legacy/requirements/requirements.crawler.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copier les sources du crawler
COPY VERSION ./VERSION
COPY src/ ./src/
COPY config/ ./config/
COPY database/ ./database/

# Créer les répertoires nécessaires
RUN mkdir -p logs archives data

# Variables d'environnement
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV OPENINDEX_APP_VERSION=${OPENINDEX_APP_VERSION}
ENV OPENINDEX_BUILD_COMMIT=${OPENINDEX_BUILD_COMMIT}
ENV OPENINDEX_BUILD_DATE=${OPENINDEX_BUILD_DATE}

# Point d'entrée par défaut
ENTRYPOINT ["python", "src/smb_crawler_postgresql.py"]
CMD ["worker"]
