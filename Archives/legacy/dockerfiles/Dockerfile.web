# Dockerfile pour le service Web UI
FROM python:3.11-slim

ARG OPENINDEX_APP_VERSION=0.4.12
ARG OPENINDEX_BUILD_COMMIT=dev
ARG OPENINDEX_BUILD_DATE=20260401_173742

# Métadonnées
LABEL maintainer="OpenIndex Team"
LABEL description="OpenIndex Web UI Service"
LABEL version="${OPENINDEX_APP_VERSION}"
LABEL org.opencontainers.image.version="${OPENINDEX_APP_VERSION}"
LABEL org.opencontainers.image.revision="${OPENINDEX_BUILD_COMMIT}"
LABEL org.opencontainers.image.created="${OPENINDEX_BUILD_DATE}"

# Configuration
WORKDIR /app

# Installation des dépendances système
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Installation des dépendances Python
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copier les sources de l'interface web
COPY src/web_interface_v2.py ./src/
COPY src/postgres_adapter.py ./src/
COPY src/config_manager.py ./src/
COPY src/logging_config.py ./src/
COPY config/ ./config/

# Créer les répertoires nécessaires
RUN mkdir -p logs data

# Variables d'environnement Streamlit
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV STREAMLIT_SERVER_PORT=8502
ENV STREAMLIT_SERVER_ADDRESS=0.0.0.0
ENV STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Health check pour l'interface web
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8502/_stcore/health || exit 1

# Point d'entrée
ENTRYPOINT ["streamlit", "run", "src/web_interface_v2.py"]
CMD ["--server.port", "8502", "--server.address", "0.0.0.0"]
